{
  "name": "codex-web",
  "version": "0.0.1",
  "files": [
    "README.md",
    "scripts/managed-runtime.mjs",
    "scripts/run-server.mjs",
    "scripts/runtime-versions.json",
    "scripts/tailscale.mjs",
    "scratch/asar/**/*",
    "src/server/**/*.js",
    "src/server/electron/index.js",
    "!**/*.ts"
  ],
  "bin": "scripts/run-server.mjs",
  "scripts": {
    "prepare": "node ./scripts/prepare-package.mjs",
    "build": "node ./scripts/prepare-package.mjs",
    "launch:unpacked:server": "http-server ./scratch/asar/webview -a localhost -p 5175 -c-1",
    "launch:unpacked": "NODE_ENV=development electron ./scratch/asar --remote-debugging-port=9222",
    "dev:browser": "vite --config vite.browser.config.mjs",
    "build:browser": "vite build --config vite.browser.config.mjs",
    "build:server": "cd src/server && tsc",
    "rebuild:native": "npm rebuild better-sqlite3 node-pty",
    "prepare:asar": "bash ./scripts/unix/prepare-asar.sh",
    "preserver": "npm run build:server && npm run build:browser",
    "server": "node scripts/run-server.mjs"
  },
  "repository": "git@github.com:0xcaff/codex-web.git",
  "author": "martin <martincharles07@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "@electron/asar": "^4.2.0",
    "@fastify/multipart": "^10.0.0",
    "@fastify/static": "^10.1.3",
    "@tanstack/react-query": "^5.100.9",
    "@types/ws": "^8.18.1",
    "better-sqlite3": "^12.9.0",
    "fastify": "^5.11.2",
    "glob": "^13.0.6",
    "node-pty": "^1.1.0",
    "prettier": "^3.8.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "0.35.3",
    "typescript": "^6.0.2",
    "vite": "^8.2.1",
    "ws": "^8.21.2"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "electron": "42.3.0",
    "http-server": "^14.1.1"
  }
}
