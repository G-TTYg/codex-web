#!/usr/bin/env bash
set -euo pipefail

if [[ -n "${HOSTED_CODEX_APP_ZIP:-}" ]]; then
  bash ./scripts/prepare_asar
  exit 0
fi

TEMP_DIR="$(mktemp -d)"
trap 'rm -rf "$TEMP_DIR"' EXIT

APP_VERSION="${CODEX_DESKTOP_VERSION:-26.730.61639}"
curl --fail --location --output "$TEMP_DIR/file.zip" "https://persistent.oaistatic.com/codex-app-prod/ChatGPT-darwin-arm64-$APP_VERSION.zip"

HOSTED_CODEX_APP_ZIP="$TEMP_DIR/file.zip" bash ./scripts/prepare_asar
