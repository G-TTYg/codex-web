#!/usr/bin/env bash
set -euo pipefail

if [[ -n "${HOSTED_CODEX_APP_ZIP:-}" ]]; then
  bash ./scripts/prepare_asar
  exit 0
fi

TEMP_DIR="$(mktemp -d)"
trap 'rm -rf "$TEMP_DIR"' EXIT

DEFAULT_APP_VERSION="$(node -p "require('./scripts/runtime-versions.json').desktop.version")"
APP_VERSION="${CODEX_DESKTOP_VERSION:-$DEFAULT_APP_VERSION}"
if [[ "$APP_VERSION" == "$DEFAULT_APP_VERSION" ]]; then
  APP_URL="$(node -p "require('./scripts/runtime-versions.json').desktop.url")"
else
  APP_URL="https://persistent.oaistatic.com/codex-app-prod/ChatGPT-darwin-arm64-$APP_VERSION.zip"
fi
curl --fail --location --output "$TEMP_DIR/file.zip" "$APP_URL"

HOSTED_CODEX_APP_ZIP="$TEMP_DIR/file.zip" bash ./scripts/prepare_asar
